// Windows resources: the .exe icon and the version shown in File Properties.
#include <winver.h>

1 ICON "snapclip.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_COMMA
PRODUCTVERSION  VERSION_COMMA
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "SnapClip"
      VALUE "FileDescription",  "SnapClip - screenshots and clipboard history"
      VALUE "FileVersion",      VERSION_STR
      VALUE "InternalName",     "snapclip"
      VALUE "OriginalFilename", "snapclip.exe"
      VALUE "ProductName",      "SnapClip"
      VALUE "ProductVersion",   VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
